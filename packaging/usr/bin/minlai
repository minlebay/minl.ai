#!/bin/bash
# minl.ai launcher — activates the venv and delegates to main.py
INSTALL_DIR="/usr/lib/minlai"
VENV_PYTHON="$INSTALL_DIR/venv/bin/python3"

if [ ! -x "$VENV_PYTHON" ]; then
    echo "minl.ai venv not found. Try: sudo dpkg --configure minlai" >&2
    exit 1
fi

# venv/bin/python3 links to the system python3; if that moved to a new minor
# version, the venv's packages (in lib/python3.X) are no longer importable.
PY_NAME="$(basename "$(readlink -f "$VENV_PYTHON")")"   # e.g. python3.14
if [ ! -d "$INSTALL_DIR/venv/lib/$PY_NAME" ]; then
    msg="System Python was upgraded to ${PY_NAME#python}; rebuild the minl.ai environment with: sudo dpkg-reconfigure minlai"
    echo "minl.ai: $msg" >&2
    command -v notify-send >/dev/null 2>&1 \
        && notify-send -a minl.ai -i minlai "minl.ai can't start" "$msg"
    exit 1
fi

exec "$VENV_PYTHON" "$INSTALL_DIR/main.py" "$@"
